{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hs-chem/knowledge-record.schema.json",
  "x-source-schema-version": "3.2.0",
  "oneOf": [
    {"$ref": "#/$defs/entity"},
    {"$ref": "#/$defs/reaction"},
    {"$ref": "#/$defs/rule"},
    {"$ref": "#/$defs/source"},
    {"$ref": "#/$defs/evidence"},
    {"$ref": "#/$defs/teachingView"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_:-]+$"},
    "scalar": {"type": ["string", "boolean", "integer"]},
    "context": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/scalar"}
    },
    "count": {"type": "integer", "minimum": 1},
    "coefficient": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "additionalProperties": false,
      "properties": {
        "numerator": {"type": "integer", "minimum": 1},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "composition": {
      "type": "object",
      "required": ["components", "net_charge"],
      "additionalProperties": false,
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["element_id", "count"],
            "additionalProperties": false,
            "properties": {
              "element_id": {"$ref": "#/$defs/id"},
              "count": {"$ref": "#/$defs/count"}
            }
          }
        },
        "net_charge": {"type": "integer"}
      }
    },
    "factState": {"enum": ["known", "unknown", "not_applicable"]},
    "factKind": {"enum": ["intrinsic", "contextual", "derived"]},
    "factValue": {"type": ["boolean", "string", "integer", "null"]},
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "facetAssertion": {
      "type": "object",
      "required": ["facet_key", "value_state"],
      "additionalProperties": false,
      "properties": {
        "facet_key": {"type": "string", "minLength": 1},
        "value_state": {"$ref": "#/$defs/factState"},
        "value": {"$ref": "#/$defs/factValue"},
        "fact_kind": {"$ref": "#/$defs/factKind"},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "propertyAssertion": {
      "type": "object",
      "required": ["property_key", "value_state"],
      "additionalProperties": false,
      "properties": {
        "property_key": {"type": "string", "minLength": 1},
        "value_state": {"$ref": "#/$defs/factState"},
        "value": {"$ref": "#/$defs/factValue"},
        "fact_kind": {"$ref": "#/$defs/factKind"},
        "context": {"$ref": "#/$defs/context"},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "relationAssertion": {
      "type": "object",
      "required": ["relation_key", "target_id", "context", "evidence_ids"],
      "additionalProperties": false,
      "properties": {
        "relation_key": {"enum": ["metal.product_cation"]},
        "target_id": {"$ref": "#/$defs/id"},
        "context": {"$ref": "#/$defs/context"},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "speciationProduct": {
      "type": "object",
      "required": ["target_id", "coefficient"],
      "additionalProperties": false,
      "properties": {
        "target_id": {"$ref": "#/$defs/id"},
        "coefficient": {"$ref": "#/$defs/coefficient"}
      }
    },
    "speciationProfile": {
      "type": "object",
      "required": ["profile_key", "context", "model", "products", "evidence_ids"],
      "additionalProperties": false,
      "properties": {
        "profile_key": {"type": "string", "minLength": 1},
        "context": {"$ref": "#/$defs/context"},
        "model": {"enum": ["strong_electrolyte_complete_dissociation"]},
        "products": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/speciationProduct"}
        },
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "entity": {
      "type": "object",
      "required": ["id", "record_type", "entity_kind", "terms", "payload"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "record_type": {"const": "entity"},
        "entity_kind": {"enum": ["element", "species", "substance", "material_system"]},
        "terms": {
          "type": "object",
          "required": ["preferred"],
          "additionalProperties": false,
          "properties": {
            "preferred": {"type": "string", "minLength": 1},
            "aliases": {"type": "array", "items": {"type": "string"}}
          }
        },
        "semantic_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["scheme", "value"],
            "additionalProperties": false,
            "properties": {
              "scheme": {"type": "string"},
              "value": {"type": "string"}
            }
          }
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "atomic_number": {"type": "integer", "minimum": 1},
            "symbol": {"type": "string"},
            "species_kind": {"enum": ["atom", "ion", "molecule"]},
            "substance_kind": {"enum": ["elemental", "pure_compound"]},
            "material_system_kind": {"enum": ["solution", "mixture"]},
            "composition": {"$ref": "#/$defs/composition"},
            "formal_charge": {"type": "integer"}
          }
        },
        "facet_assertions": {"type": "array", "items": {"$ref": "#/$defs/facetAssertion"}},
        "property_assertions": {"type": "array", "items": {"$ref": "#/$defs/propertyAssertion"}},
        "relation_assertions": {"type": "array", "items": {"$ref": "#/$defs/relationAssertion"}},
        "speciation_profiles": {"type": "array", "items": {"$ref": "#/$defs/speciationProfile"}},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "participant": {
      "type": "object",
      "required": ["target_id", "target_kind", "role", "coefficient", "phase"],
      "additionalProperties": false,
      "properties": {
        "target_id": {"$ref": "#/$defs/id"},
        "target_kind": {"enum": ["element", "species", "substance", "material_system"]},
        "role": {"enum": ["reactant", "product"]},
        "coefficient": {"$ref": "#/$defs/coefficient"},
        "phase": {"enum": ["solid", "liquid", "gas", "aqueous", "dissolved", "unknown"]}
      }
    },
    "reactionForm": {
      "type": "object",
      "required": ["form_key", "form_kind", "participants", "projection"],
      "additionalProperties": false,
      "properties": {
        "form_key": {"type": "string", "minLength": 1},
        "form_kind": {"enum": ["molecular", "complete_ionic", "net_ionic", "thermochemical"]},
        "participants": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/participant"}},
        "projection": {
          "type": "object",
          "required": ["method", "required_assumptions"],
          "additionalProperties": false,
          "properties": {
            "method": {"type": "string", "minLength": 1},
            "lifecycle": {"enum": ["curated", "golden", "override"]},
            "required_assumptions": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "notes": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "reactionCondition": {
      "type": "object",
      "required": ["key", "value", "evidence_ids"],
      "additionalProperties": false,
      "properties": {
        "key": {"enum": ["medium", "temperature_regime"]},
        "value": {"enum": ["aqueous", "warmed"]},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      },
      "allOf": [
        {
          "if": {"properties": {"key": {"const": "medium"}}},
          "then": {"properties": {"value": {"const": "aqueous"}}}
        },
        {
          "if": {"properties": {"key": {"const": "temperature_regime"}}},
          "then": {"properties": {"value": {"const": "warmed"}}}
        }
      ]
    },
    "reaction": {
      "type": "object",
      "required": ["id", "record_type", "participants", "forms", "evidence_ids"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "record_type": {"const": "reaction"},
        "participants": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/participant"}},
        "conditions": {"type": "array", "items": {"$ref": "#/$defs/reactionCondition"}},
        "forms": {"type": "array", "items": {"$ref": "#/$defs/reactionForm"}},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "reactantPattern": {
      "type": "object",
      "required": ["bind"],
      "additionalProperties": false,
      "properties": {
        "bind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "target_id": {"$ref": "#/$defs/id"},
        "entity_kind": {"enum": ["element", "species", "substance", "material_system"]},
        "species_kind": {"enum": ["atom", "ion", "molecule"]},
        "required_facets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden_facets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "anyOf": [
        {"required": ["target_id"]},
        {"required": ["entity_kind"]},
        {"required": ["species_kind"]},
        {"required": ["required_facets"]},
        {"required": ["forbidden_facets"]}
      ]
    },
    "predicate": {
      "type": "object",
      "required": ["operator", "subject", "key"],
      "additionalProperties": false,
      "properties": {
        "operator": {"enum": ["equals", "not_equals", "is_known", "in_set"]},
        "subject": {"enum": ["context", "facet", "property", "ionic_exchange"]},
        "binding": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "bindings": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "key": {"type": "string", "minLength": 1},
        "expected": {
          "type": ["string", "boolean", "integer", "array"],
          "items": {"type": ["string", "boolean", "integer"]}
        }
      }
    },
    "blocker": {
      "oneOf": [
        {
          "type": "object",
          "required": ["key", "equals"],
          "additionalProperties": false,
          "properties": {"key": {"type": "string"}, "equals": {"$ref": "#/$defs/scalar"}}
        },
        {"$ref": "#/$defs/predicate"}
      ]
    },
    "semanticKeyConstruct": {
      "type": "object",
      "required": ["kind", "scheme", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "semantic_key"},
        "scheme": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "speciationIonSource": {
      "type": "object",
      "required": ["kind", "binding"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "speciation"},
        "binding": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    },
    "relationTargetIonSource": {
      "type": "object",
      "required": ["kind", "binding", "relation_key"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "relation_target"},
        "binding": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "relation_key": {"enum": ["metal.product_cation"]}
      }
    },
    "ionSource": {
      "oneOf": [
        {"$ref": "#/$defs/speciationIonSource"},
        {"$ref": "#/$defs/relationTargetIonSource"}
      ]
    },
    "ionicPairConstruct": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "cation_from", "anion_from"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "ionic_pair"},
            "cation_from": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "anion_from": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
          }
        },
        {
          "type": "object",
          "required": ["kind", "cation_source", "anion_source"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "ionic_pair"},
            "cation_source": {"$ref": "#/$defs/ionSource"},
            "anion_source": {"$ref": "#/$defs/ionSource"}
          }
        }
      ]
    },
    "exchangeProductConstruct": {
      "type": "object",
      "required": ["kind", "left_binding", "right_binding", "role"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "exchange_product"},
        "left_binding": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "right_binding": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "role": {"enum": ["precipitate", "counterproduct"]}
      }
    },
    "product": {
      "type": "object",
      "required": ["phase"],
      "additionalProperties": false,
      "properties": {
        "target_id": {"$ref": "#/$defs/id"},
        "phase": {"enum": ["solid", "liquid", "gas", "aqueous", "dissolved", "unknown"]},
        "construct": {
          "oneOf": [
            {"$ref": "#/$defs/semanticKeyConstruct"},
            {"$ref": "#/$defs/ionicPairConstruct"},
            {"$ref": "#/$defs/exchangeProductConstruct"}
          ]
        }
      },
      "oneOf": [{"required": ["target_id"]}, {"required": ["construct"]}]
    },
    "rule": {
      "type": "object",
      "required": ["id", "record_type", "version", "decision_domain", "match", "products", "validators", "evidence_ids"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "record_type": {"const": "rule"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "decision_domain": {"type": "string", "minLength": 1},
        "match": {
          "type": "object",
          "required": ["reactants"],
          "additionalProperties": false,
          "properties": {"reactants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reactantPattern"}}}
        },
        "context": {"$ref": "#/$defs/context"},
        "predicates": {"type": "array", "items": {"$ref": "#/$defs/predicate"}},
        "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}},
        "products": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/product"}},
        "validators": {"type": "array", "minItems": 1, "items": {"enum": ["atoms_conserved", "charge_conserved"]}},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"},
        "overrides": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "specializes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "fallback_for": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "equivalent_to": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "mutually_exclusive_with": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "record_type", "source_type", "citation"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "record_type": {"const": "source"},
        "source_type": {"enum": ["textbook", "standard", "fixture"]},
        "citation": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "record_type", "source_id", "claim_summary", "stance"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "record_type": {"const": "evidence"},
        "source_id": {"$ref": "#/$defs/id"},
        "claim_summary": {"type": "string", "minLength": 1},
        "stance": {"enum": ["supports", "qualifies", "contradicts"]}
      }
    },
    "teachingNode": {
      "type": "object",
      "required": ["path_key"],
      "additionalProperties": false,
      "properties": {
        "path_key": {"type": "string", "minLength": 1},
        "parent_path_key": {"type": "string", "minLength": 1},
        "members": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    },
    "teachingView": {
      "type": "object",
      "required": ["id", "record_type", "view_key", "nodes"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "record_type": {"const": "teaching_view"},
        "view_key": {"type": "string", "minLength": 1},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/teachingNode"}}
      }
    }
  }
}
