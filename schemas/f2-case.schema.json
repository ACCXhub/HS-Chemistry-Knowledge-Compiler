{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["cases"],
  "additionalProperties": false,
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reactants", "context"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_:-]+$"},
          "reactants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["target_id", "phase"],
              "additionalProperties": false,
              "properties": {
                "target_id": {"type": "string"},
                "phase": {"enum": ["solid", "liquid", "gas", "aqueous", "dissolved", "unknown"]}
              }
            }
          },
          "context": {
            "type": "object",
            "additionalProperties": {"type": ["string", "boolean", "integer"]}
          }
        }
      }
    }
  }
}
